{
  "name": "Text Selection Translator",
  "version": "1.0",
  "manifest_version": 3,
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true
    }
  ],
  "background": { "service_worker": "service.js" },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": ["res/popup_icon.svg"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "res/logo-16.png",
    "32": "res/logo-32.png"
  },

  "permissions": ["storage"],
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://api.deepseek.com/*"
  ]
}
